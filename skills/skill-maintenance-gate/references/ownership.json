{
  "version": 1,
  "default_owner": "code-self-review",
  "rules": [
    {"pattern": "skills/skill-maintenance-gate/**", "owners": ["skill-maintenance-gate"]},
    {"pattern": "AGENTS.md", "owners": ["skill-maintenance-gate"]},
    {"pattern": "conftest.py", "owners": ["skill-maintenance-gate"]},
    {"pattern": "src/ei_ui_smoke/zentao.py", "owners": ["zentao-bug-submission"]},
    {"pattern": "src/ei_ui_smoke/bug_priority.py", "owners": ["bug-severity-priority"]},
    {"pattern": "src/ei_ui_smoke/failure_evidence.py", "owners": ["zentao-bug-submission"]},
    {"pattern": "src/ei_ui_smoke/data_strategy.py", "owners": ["smoke-test-data-strategy"]},
    {"pattern": "src/ei_ui_smoke/values.py", "owners": ["smoke-test-data-strategy"]},
    {"pattern": "src/ei_ui_smoke/qcc_*.py", "owners": ["smoke-test-data-strategy"]},
    {"pattern": "src/ei_ui_smoke/runtime_menu.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "src/ei_ui_smoke/menu_capture.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "src/ei_ui_smoke/module_index.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "src/ei_ui_smoke/module_resolver.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "src/ei_ui_smoke/common_field*.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/module_driver.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/dom.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/interactions.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/source_form.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/verification.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "src/ei_ui_smoke/*.py", "owners": ["ui-smoke-test"]},
    {"pattern": "tests/test_zentao.py", "owners": ["zentao-bug-submission"]},
    {"pattern": "tests/test_bug_priority.py", "owners": ["bug-severity-priority"]},
    {"pattern": "tests/test_common_field*.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "tests/test_*_personalized.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "tests/test_module_driver.py", "owners": ["generic-module-crud-smoke"]},
    {"pattern": "tests/test_runtime_menu.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "tests/test_menu_capture.py", "owners": ["runtime-module-discovery"]},
    {"pattern": "tests/test_data_strategy.py", "owners": ["smoke-test-data-strategy"]},
    {"pattern": "tests/test_skill_maintenance_gate.py", "owners": ["skill-maintenance-gate"]},
    {"pattern": "tests/*.py", "owners": ["ui-smoke-test"]},
    {"pattern": "tools/*.py", "owners": ["code-self-review"]},
    {"pattern": "pyproject.toml", "owners": ["ui-smoke-test"]},
    {"pattern": "run_test.vbs", "owners": ["ui-smoke-test"]}
  ],
  "governed_patterns": [
    "AGENTS.md",
    "conftest.py",
    "pyproject.toml",
    "run_test.vbs",
    "src/**/*.py",
    "tests/**/*.py",
    "tools/**/*.py",
    "skills/skill-maintenance-gate/**"
  ],
  "ignored_patterns": ["**/__pycache__/**", "**/*.pyc"]
}
